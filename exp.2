}

input,select,textarea{

    width:100%;
    padding:8px;
    margin:8px 0 15px;

}

input[type=radio],
input[type=checkbox]{

    width:auto;

}

input[type=submit],
input[type=reset]{

    width:120px;
    background:#1565c0;
    color:white;
    border:none;
    padding:10px;
    cursor:pointer;

}

iframe,
video,
embed{

    width:100%;
    max-width:700px;
    display:block;
    margin:auto;

}

footer{

    background:#0d47a1;
    color:white;
    text-align:center;
    padding:20px;

}

</style>

