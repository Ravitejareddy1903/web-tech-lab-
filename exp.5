<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Karunya | Web Developer Portfolio</title>
<meta name="description" content="Portfolio of Karunya: JavaScript DOM and events projects with live demos.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F4F6FB; --surface:#fff; --ink:#0E1A2B; --muted:#55627A; --line:#D9DEEA;
  --accent:#2F4BFF; --on-accent:#fff; --hi:#FFD447; --panel:#0E1A2B; --panel-ink:#E8EDF7;
  --r:14px; --hd:'Bricolage Grotesque','Segoe UI',system-ui,sans-serif; --bd:'Figtree','Segoe UI',system-ui,sans-serif;
}
:root[data-theme="dark"]{
  --bg:#0B1220; --surface:#131C2E; --ink:#E8EDF7; --muted:#93A0B8; --line:#26324A;
  --accent:#8595FF; --on-accent:#0B1220; --panel:#070C17;
}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{background:var(--bg);color:var(--ink);font:400 1rem/1.65 var(--bd);-webkit-text-size-adjust:100%}
h1,h2,h3{font-family:var(--hd);line-height:1.1;letter-spacing:-.02em}
a{color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px;border-radius:6px}
.wrap{width:min(1120px,100% - 2rem);margin-inline:auto}
section{padding:clamp(3rem,8vw,6rem) 0}
.sr{position:absolute;left:-9999px}

/* nav */
header{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;justify-content:space-between;height:64px;gap:1rem}
.logo{font:800 1.25rem var(--hd);text-decoration:none}
.logo span{background:var(--hi);color:#0E1A2B;padding:0 .3em;border-radius:6px;margin-right:.15em}
nav ul{display:flex;gap:.25rem;list-style:none;padding:0}
nav a{display:block;padding:.45rem .8rem;border-radius:99px;text-decoration:none;font-weight:500;color:var(--muted)}
nav a:hover{color:var(--ink);background:var(--line)}
.tools{display:flex;gap:.5rem}
.icon-btn{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:var(--surface);color:var(--ink);font-size:1.1rem;cursor:pointer}
#menu-btn{display:none}
@media(max-width:760px){
  #menu-btn{display:block}
  nav{position:absolute;inset:64px 0 auto 0;background:var(--bg);border-bottom:1px solid var(--line);display:none;padding:.5rem 1rem 1rem}
  nav.open{display:block}
  nav ul{flex-direction:column}
  nav a{padding:.8rem 1rem;font-size:1.05rem}
}

/* hero */
.hero{max-width:820px;padding-top:clamp(3rem,9vw,7rem)}
.hero h1{font-size:clamp(2.4rem,6.4vw,4.6rem);font-weight:800}
.hero h1 mark{background:linear-gradient(transparent 58%,var(--hi) 58%);color:inherit}
.hero p{max-width:56ch;color:var(--muted);margin:1.25rem 0 1.75rem;font-size:1.08rem}
.cta{display:flex;flex-wrap:wrap;gap:.75rem}
.btn{display:inline-block;font:600 1rem var(--bd);padding:.75rem 1.4rem;border-radius:99px;border:2px solid var(--accent);background:var(--accent);color:var(--on-accent);text-decoration:none;cursor:pointer;transition:transform .15s}
.btn:hover{transform:translateY(-2px)}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--ink)}

/* headings */
.head{max-width:60ch;margin-bottom:2rem}
.head h2{font-size:clamp(1.8rem,4.4vw,2.8rem)}
.head p{color:var(--muted);margin-top:.6rem}

/* about */
.about{display:grid;grid-template-columns:1fr 1fr;gap:clamp(1.5rem,5vw,4rem)}
.about p+p{margin-top:1rem}
.skills{display:grid;gap:1rem;align-content:start}
.skill label{display:flex;justify-content:space-between;font-weight:600;margin-bottom:.35rem}
.meter{height:10px;background:var(--line);border-radius:99px;overflow:hidden}
.meter div{height:100%;width:0;background:var(--accent);border-radius:99px;transition:width 1s ease}
@media(max-width:800px){.about{grid-template-columns:1fr}}

/* projects */
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:1.25rem}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:1.4rem;display:flex;flex-direction:column;gap:.9rem}
.card h3{font-size:1.3rem}
.card>p{color:var(--muted);font-size:.95rem;margin-top:-.4rem}
.tag{align-self:flex-start;font:500 .78rem ui-monospace,Consolas,monospace;background:color-mix(in srgb,var(--accent) 14%,transparent);color:var(--accent);padding:.2rem .6rem;border-radius:6px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}
.field{display:grid;gap:.25rem;font-size:.85rem;font-weight:600}
input[type=text],input[type=email],input[type=number],select,textarea{width:100%;font:inherit;font-weight:400;padding:.6rem .75rem;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink)}
textarea{min-height:110px;resize:vertical}
.out{background:var(--bg);border:1px dashed var(--line);border-radius:10px;padding:.7rem .9rem;min-height:3rem;font-size:.95rem}
.out b{color:var(--accent)}
.radios{display:flex;flex-wrap:wrap;gap:.9rem;font-size:.9rem}
.radios label{display:flex;gap:.35rem;align-items:center}
#garden{display:grid;gap:4px}
#garden span{aspect-ratio:1;display:grid;place-items:center;background:var(--bg);border-radius:8px;font-size:clamp(1rem,4vw,1.6rem)}
.coin-wrap{display:flex;align-items:center;gap:1.2rem;flex-wrap:wrap}
#coin{width:84px;height:84px;border-radius:50%;display:grid;place-items:center;font:800 2rem var(--hd);background:radial-gradient(circle at 30% 30%,#FFE58A,#E0A800);color:#5a4200;border:4px solid #b98700}
#coin.tails{background:radial-gradient(circle at 30% 30%,#E6EAF2,#9AA6BC);color:#2b3548;border-color:#6f7b92}
#coin.spin{animation:spin .5s}
@keyframes spin{from{transform:rotateY(0)}to{transform:rotateY(720deg)}}
.cake .total{font:800 1.6rem var(--hd);color:var(--accent)}

/* contact */
.contact{display:grid;grid-template-columns:1fr 1.2fr;gap:clamp(1.5rem,5vw,4rem)}
.contact form{display:grid;gap:.9rem}
.links{list-style:none;padding:0;display:grid;gap:.5rem;margin-top:1rem}
#msg{min-height:1.5rem;font-weight:600;color:var(--accent)}
@media(max-width:800px){.contact{grid-template-columns:1fr}}
footer{border-top:1px solid var(--line);padding:1.5rem 0;color:var(--muted);font-size:.9rem}
.reveal{opacity:0;transform:translateY(16px);transition:opacity .6s,transform .6s}
.reveal.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}.reveal{opacity:1;transform:none}}
</style>
</head>
<body>

<header>
  <div class="wrap bar">
    <a class="logo" href="#top"><span>K</span>arunya</a>
    <nav id="nav" aria-label="Main">
      <ul>
        <li><a href="#about">About</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
    <div class="tools">
      <button class="icon-btn" id="theme-btn" aria-label="Switch color theme" title="Switch theme">◐</button>
      <button class="icon-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false">☰</button>
    </div>
  </div>
</header>

<main id="top">
<div class="wrap">
  <section class="hero" style="padding-bottom:0">
    <div>
      <h1>I build web pages that <mark>react to you</mark>.</h1>
      <p>I'm Karunya, a front-end developer who turns HTML into working tools with JavaScript. Every project below is live, so click, type and flip things to try them.</p>
      <div class="cta">
        <a class="btn" href="#projects">Try the projects</a>
        <a class="btn ghost" href="#contact">Get in touch</a>
      </div>
    </div>
  </section>

  <section id="about" class="reveal">
    <div class="about">
      <div class="head" style="margin:0">
        <h2>Learning the DOM by building with it</h2>
        <p>The Document Object Model is how JavaScript reads and changes a page. I practise it with small, focused tools: find an element, listen for an event, update the result.</p>
        <p>These projects come from my JavaScript lab on DOM elements and events, rebuilt as a portfolio you can use.</p>
      </div>
      <div class="skills" id="skills">
        <div class="skill" data-v="90"><label>HTML &amp; CSS <span>90%</span></label><div class="meter"><div></div></div></div>
        <div class="skill" data-v="80"><label>JavaScript DOM <span>80%</span></label><div class="meter"><div></div></div></div>
        <div class="skill" data-v="75"><label>Event handling <span>75%</span></label><div class="meter"><div></div></div></div>
        <div class="skill" data-v="70"><label>Responsive design <span>70%</span></label><div class="meter"><div></div></div></div>
      </div>
    </div>
  </section>

  <section id="projects" style="padding-top:0">
    <div class="head">
      <h2>Projects you can use right now</h2>
      <p>Each card shows the DOM method or event behind it.</p>
    </div>
    <div class="grid">

      <article class="card">
        <span class="tag">getElementById · split()</span>
        <h3>Word finder</h3>
        <p>Finds the shortest and longest word in a sentence.</p>
        <label class="field">Sentence<input type="text" id="wf-in" value="Web Development Tutorial"></label>
        <button class="btn" id="wf-go">Find words</button>
        <div class="out" id="wf-out" aria-live="polite"></div>
      </article>

      <article class="card">
        <span class="tag">onclick · innerHTML</span>
        <h3>BMI calculator</h3>
        <p>Weight divided by height squared, with your body type.</p>
        <div class="row">
          <label class="field">Weight (kg)<input type="number" id="weight" min="1" step="any" inputmode="decimal" value="60"></label>
          <label class="field">Height (m)<input type="number" id="height" min="0.5" step="any" inputmode="decimal" value="1.65"></label>
        </div>
        <button class="btn" id="bmi-go">Get BMI</button>
        <div class="out" aria-live="polite">Your BMI is <b id="score">–</b>.<br>Your body type is <b id="type">–</b>.</div>
      </article>

      <article class="card">
        <span class="tag">Math.random() · innerHTML +=</span>
        <h3>Fruit farm</h3>
        <p>Plants a grid where each bed is an apple or an orange, 50/50.</p>
        <div class="row">
          <label class="field">Rows<input type="number" id="rows" min="1" max="10" value="3"></label>
          <label class="field">Columns<input type="number" id="columns" min="1" max="10" value="5"></label>
        </div>
        <button class="btn" id="plant">Plant garden</button>
        <div id="garden" aria-live="polite"></div>
      </article>

      <article class="card">
        <span class="tag">selectedIndex · select</span>
        <h3>Currency converter</h3>
        <p>Rupees to dollars and back (₹1 = $0.015, $1 = ₹67.12).</p>
        <label class="field">Amount<input type="number" id="data" min="0" step="any" inputmode="decimal" value="100"></label>
        <div class="row">
          <label class="field">From<select id="from"><option value="inr">Indian Rupee</option><option value="usd">US Dollar</option></select></label>
          <label class="field">To<select id="to"><option value="usd">US Dollar</option><option value="inr">Indian Rupee</option></select></label>
        </div>
        <button class="btn" id="convert">Calculate</button>
        <div class="out" id="answer" aria-live="polite"></div>
      </article>

      <article class="card">
        <span class="tag">addEventListener · classList</span>
        <h3>Heads or tails?</h3>
        <p>A fair flip every time, with a running tally.</p>
        <div class="coin-wrap">
          <div id="coin" aria-label="Coin showing heads">H</div>
          <button class="btn" id="flip">Flip!</button>
        </div>
        <div class="out" aria-live="polite">Heads total: <b id="num_heads">0</b><br>Tails total: <b id="num_tails">0</b></div>
      </article>

      <article class="card cake">
        <span class="tag">querySelector · radio :checked</span>
        <h3>Birthday cake order</h3>
        <p>₹100 per ½ kg, ₹200 per 1 kg, ₹400 per 2 kg, plus 9% tax, then your tip.</p>
        <div class="row">
          <label class="field">½ kg cakes<input type="number" id="small" min="0" value="1"></label>
          <label class="field">1 kg cakes<input type="number" id="medium" min="0" value="1"></label>
        </div>
        <label class="field">2 kg cakes<input type="number" id="large" min="0" value="0"></label>
        <div class="radios" role="radiogroup" aria-label="Tip">
          <span>Tip:</span>
          <label><input type="radio" name="tip" value="10"> 10%</label>
          <label><input type="radio" name="tip" value="15" checked> 15%</label>
          <label><input type="radio" name="tip" value="20"> 20%</label>
        </div>
        <button class="btn" id="submit">Calculate order</button>
        <div class="out" aria-live="polite">Cost of order: <span class="total">₹<span id="price">0.00</span></span></div>
      </article>

    </div>
  </section>

  <section id="contact" class="reveal">
    <div class="contact">
      <div class="head" style="margin:0">
        <h2>Let's build something</h2>
        <p>Have a project, an internship or a question? Send a note and I'll reply soon.</p>
        <ul class="links">
          <li><a href="mailto:hello@example.com">hello@example.com</a></li>
          <li><a href="https://github.com/" rel="noopener">GitHub</a></li>
          <li><a href="https://www.linkedin.com/" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
      <form id="contact-form" novalidate>
        <label class="field">Name<input type="text" id="c-name" required autocomplete="name"></label>
        <label class="field">Email<input type="email" id="c-mail" required autocomplete="email"></label>
        <label class="field">Message<textarea id="c-text" required></textarea></label>
        <button class="btn" type="submit">Send message</button>
        <p id="msg" role="status"></p>
      </form>
    </div>
  </section>
</div>
</main>

<footer><div class="wrap">© <span id="year"></span> Karunya. Built with HTML, CSS and vanilla JavaScript.</div></footer>

<script>
const $ = id => document.getElementById(id);
const esc = s => s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const num = id => parseFloat($(id).value);

/* ---------- Theme + menu ---------- */
const root = document.documentElement;
try{ const t = localStorage.getItem('theme'); if(t) root.dataset.theme = t; }catch(e){}
$('theme-btn').addEventListener('click', () => {
  const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
  root.dataset.theme = next;
  try{ localStorage.setItem('theme', next); }catch(e){}
});
$('menu-btn').addEventListener('click', e => {
  const open = $('nav').classList.toggle('open');
  e.currentTarget.setAttribute('aria-expanded', open);
});
$('nav').addEventListener('click', e => { if(e.target.tagName === 'A') $('nav').classList.remove('open'); });
$('year').textContent = new Date().getFullYear();

/* ---------- 1. Word finder ---------- */
$('wf-go').addEventListener('click', () => {
  const words = $('wf-in').value.trim().split(/\s+/).filter(Boolean);
  if(!words.length){ $('wf-out').textContent = 'Type a sentence first.'; return; }
  let shortest = words[0], longest = words[0];
  words.forEach(w => {
    if(w.length < shortest.length) shortest = w;
    if(w.length > longest.length) longest = w;
  });
  $('wf-out').innerHTML = `Shortest: <b>${esc(shortest)}</b><br>Longest: <b>${esc(longest)}</b>`;
});
$('wf-go').click();

/* ---------- 2. BMI ---------- */
function calculate(){
  const weight = num('weight'), height = num('height');
  if(!(weight > 0 && height > 0)){ $('score').innerHTML = '–'; $('type').innerHTML = 'enter weight and height'; return; }
  const bmi = weight / (height * height);
  let type = 'Obese';
  if(bmi < 18) type = 'Underweight';
  else if(bmi < 25) type = 'Normal';
  else if(bmi < 30) type = 'Overweight';
  $('score').innerHTML = bmi.toFixed(1);
  $('type').innerHTML = type;
}
$('bmi-go').addEventListener('click', calculate);
calculate();

/* ---------- 3. Fruit farm ---------- */
function grow(){
  const r = Math.min(Math.max(parseInt($('rows').value) || 1, 1), 10);
  const c = Math.min(Math.max(parseInt($('columns').value) || 1, 1), 10);
  const g = $('garden');
  g.innerHTML = '';
  g.style.gridTemplateColumns = `repeat(${c}, 1fr)`;
  const fruits = ['🍊','🍎'];
  for(let i = 0; i < r * c; i++){
    g.innerHTML += `<span>${fruits[Math.floor(Math.random() * 2)]}</span>`;
  }
}
$('plant').addEventListener('click', grow);
grow();

/* ---------- 4. Currency converter ---------- */
const rate = {'inr-usd':0.015, 'usd-inr':67.12, 'inr-inr':1, 'usd-usd':1};
$('convert').addEventListener('click', () => {
  const value = num('data');
  if(!(value >= 0)){ $('answer').textContent = 'Enter an amount to convert.'; return; }
  const from = $('from')[$('from').selectedIndex].value;
  const to = $('to')[$('to').selectedIndex].value;
  const result = value * rate[`${from}-${to}`];
  const sym = {inr:'₹', usd:'$'};
  $('answer').innerHTML = `${sym[from]}${value} = <b>${sym[to]}${result.toFixed(2)}</b>`;
});
$('convert').click();

/* ---------- 5. Coin flip ---------- */
let heads = 0, tails = 0;
function flipFunction(){
  const coin = $('coin');
  const isHeads = Math.random() < 0.5;
  coin.classList.remove('spin'); void coin.offsetWidth; coin.classList.add('spin');
  coin.classList.toggle('tails', !isHeads);
  coin.textContent = isHeads ? 'H' : 'T';
  coin.setAttribute('aria-label', 'Coin showing ' + (isHeads ? 'heads' : 'tails'));
  isHeads ? heads++ : tails++;
  $('num_heads').textContent = heads;
  $('num_tails').textContent = tails;
}
$('flip').addEventListener('click', flipFunction);

/* ---------- 6. Cake order ---------- */
$('submit').addEventListener('click', () => {
  const count = id => Math.max(parseInt($(id).value) || 0, 0);
  const subtotal = count('small') * 100 + count('medium') * 200 + count('large') * 400;
  const withTax = subtotal * 1.09;
  const tip = document.querySelector('input[name="tip"]:checked').value;
  $('price').textContent = (withTax * (1 + tip / 100)).toFixed(2);
});
$('submit').click();

/* ---------- Contact form ---------- */
$('contact-form').addEventListener('submit', e => {
  e.preventDefault();
  const name = $('c-name').value.trim(), mail = $('c-mail').value.trim(), text = $('c-text').value.trim();
  const msg = $('msg');
  if(!name || !text){ msg.textContent = 'Please add your name and a message.'; return; }
  if(!/^\S+@\S+\.\S+$/.test(mail)){ msg.textContent = 'Enter a valid email address.'; return; }
  msg.textContent = `Thanks, ${name}. Your message is ready to send.`;
  e.target.reset();
});

/* ---------- Skill bars + section reveal (runs once) ---------- */
const io = new IntersectionObserver(entries => entries.forEach(en => {
  if(!en.isIntersecting) return;
  en.target.classList.add('in');
  en.target.querySelectorAll('.skill').forEach(s => s.querySelector('.meter div').style.width = s.dataset.v + '%');
  io.unobserve(en.target);
}), {threshold:.15});
document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>
</body>
</html>
