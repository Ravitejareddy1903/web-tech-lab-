<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Raviteja Reddy | Personal Portfolio</title>
    <style>
        /* Global Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f4f4f4;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Header Section */
        header {
            background: linear-gradient(#1d5db8, #3d86e3);
            min-height: 180px;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .header-top {
            display: flex;
            align-items: center;
            padding: 10px;
        }

        .logo {
            width: 75px;
            height: auto;
            margin: 10px 20px;
        }

        .brand-title {
            color: #ffffff;
            font-size: 24px;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        /* Navigation Bar */
        nav {
            background: #888;
            width: 100%;
        }

        nav ul {
            list-style: none;
            display: flex;
            flex-wrap: wrap;
        }

        nav ul li {
            position: relative;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            display: block;
            padding: 15px 35px;
            font-weight: bold;
            transition: background 0.3s ease;
        }

        nav ul li:hover {
            background: red;
        }

        /* Dropdown Menu */
        .dropdown {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            background: #2c9c2c;
            width: 180px;
            z-index: 1000;
        }

        .dropdown li {
            width: 100%;
        }

        .dropdown li a {
            padding: 12px 20px;
            color: white;
            font-size: 14px;
            font-weight: normal;
        }

        nav ul li:hover .dropdown {
            display: block;
        }

        .dropdown li:hover {
            background: green;
        }

        /* Form Container */
        .container {
            flex: 1;
            background: url("https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=1500&q=80");
            background-size: cover;
            background-position: center;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 40px;
            padding: 50px 20px;
            flex-wrap: wrap;
        }

        /* Authentication Card */
        .box {
            background: white;
            width: 100%;
            max-width: 360px;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        .box h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #333333;
        }

        label {
            display: block;
            font-weight: bold;
            color: #444444;
            margin-bottom: 5px;
            font-size: 14px;
        }

        input[type="text"],
        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: 12px;
            margin-bottom: 16px;
            border: 1px solid #cccccc;
            border-radius: 5px;
            font-size: 14px;
            outline: none;
        }

        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="password"]:focus {
            border-color: #0d6efd;
        }

        input[type="submit"] {
            width: 100%;
            padding: 12px;
            border: none;
            background: #0d6efd;
            color: white;
            font-size: 16px;
            font-weight: bold;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.3s ease;
        }

        input[type="submit"]:hover {
            background: #004ecb;
        }

        /* Footer Section */
        footer {
            background: #f7deb4;
            text-align: center;
            padding: 20px;
            font-size: 15px;
            color: #333333;
            line-height: 1.6;
        }

        /* Responsive Breakpoints */

        /* Tablets & Medium Screens (max-width: 900px) */
        @media screen and (max-width: 900px) {
            .container {
                gap: 30px;
                padding: 40px 15px;
            }

            nav ul li a {
                padding: 12px 24px;
                font-size: 15px;
            }
        }

        /* Mobile Devices (max-width: 600px) */
        @media screen and (max-width: 600px) {
            header {
                min-height: auto;
            }

            .header-top {
                flex-direction: column;
                text-align: center;
                padding: 15px 10px;
            }

            .logo {
                margin: 0 0 10px 0;
                width: 65px;
            }

            .brand-title {
                font-size: 20px;
            }

            nav ul {
                flex-direction: column;
            }

            nav ul li {
                width: 100%;
                text-align: center;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            }

            nav ul li a {
                padding: 12px;
            }

            .dropdown {
                position: static;
                width: 100%;
            }

            .dropdown li a {
                background: #257e25;
                padding: 10px;
            }

            .container {
                flex-direction: column;
                padding: 30px 15px;
            }

            .box {
                max-width: 100%;
                padding: 20px;
            }

            footer {
                font-size: 13px;
                padding: 15px 10px;
            }
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <header>
        <div class="header-top">
            <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" class="logo" alt="Portfolio Icon">
            <div class="brand-title">Raviteja Reddy | Personal Portfolio</div>
        </div>
        <nav>
            <ul>
                <li>
                    <a href="#">Home</a>
                    <ul class="dropdown">
                        <li><a href="#">Projects</a></li>
                        <li><a href="#">Technical Skills</a></li>
                        <li><a href="#">Certificates</a></li>
                        <li><a href="#">Resume</a></li>
                    </ul>
                </li>
                <li><a href="#">About</a></li>
                <li><a href="#">Experience</a></li>
                <li><a href="#">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Main Section (Sign In & Sign Up Forms) -->
    <main class="container">
        <!-- Sign In Box -->
        <div class="box">
            <h2>Sign In</h2>
            <form>
                <label for="signin-username">Username</label>
                <input type="text" id="signin-username" placeholder="Enter Username" required>

                <label for="signin-password">Password</label>
                <input type="password" id="signin-password" placeholder="Enter Password" required>

                <input type="submit" value="Sign In">
            </form>
        </div>

        <!-- Sign Up Box -->
        <div class="box">
            <h2>Sign Up</h2>
            <form>
                <label for="signup-name">Full Name</label>
                <input type="text" id="signup-name" placeholder="Enter Name" required>

                <label for="signup-email">Email Address</label>
                <input type="email" id="signup-email" placeholder="Enter Email" required>

                <label for="signup-password">Password</label>
                <input type="password" id="signup-password" placeholder="Enter Password" required>

                <input type="submit" value="Sign Up">
            </form>
        </div>
    </main>

    <!-- Footer Section -->
    <footer>
        <p>Raviteja Reddy | Web Technology Lab Batch 1</p>
        <p>&copy; 2026-2027. (Register Number) - All Rights Reserved.</p>
    </footer>

</body>
</html>
